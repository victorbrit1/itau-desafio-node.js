{
  "info": {
    "name": "Desafio Itaú - API de Transações",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection baseada nas rotas do projeto itau-node. Inicie a API e configure o MySQL e a tabela transacao antes de executar. URL padrão: http://localhost:3000. Execute a pasta Fluxo CRUD na ordem apresentada: ela cria uma transação, salva o ID, consulta, atualiza e exclui apenas essa transação. Os casos de recurso inexistente usam o ID já excluído. Para executar requisições isoladas, configure transacaoId conforme necessário. Datas são geradas automaticamente em ISO 8601 com fuso horário. A API não exige autenticação."
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "transacaoId",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.variables.set('dataTransacao', new Date(Date.now() - 60000).toISOString());",
          "pm.variables.set('dataFutura', new Date(Date.now() + 86400000).toISOString());"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Fluxo CRUD - executar em ordem",
      "item": [
        {
          "name": "01 - Criar transação",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transacoes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transacoes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"valor\": 150.75,\n  \"data\": \"{{dataTransacao}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status HTTP 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.test('Retorna ID válido', () => pm.expect(body.id).to.be.a('number').and.above(0));",
                  "  pm.collectionVariables.set('transacaoId', String(body.id));",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "02 - Listar transações",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transacoes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transacoes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Retorna uma lista', () => pm.expect(pm.response.json()).to.be.an('array')); "
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "03 - Buscar transação por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transacoes/{{transacaoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transacoes",
                "{{transacaoId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Retorna a transação criada', () => pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get('transacaoId')));"
                ]
              }
            }
          ],
          "response": []
        },
